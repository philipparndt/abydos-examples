{
  "name": "in the cluster",
  "type": "java",
  "request": "launch",
  "program": "com.example.api.Server",
  "cwd": "${workspaceFolder}",
  "env": { "STAGE": "dev" },
  "ideai.devPod": {
    "context": "${currentContext}",
    "allowedContexts": "k3c-*, k3d-*, *-local",
    "namespace": "ideai-examples",
    "port": 8080
  }
}
