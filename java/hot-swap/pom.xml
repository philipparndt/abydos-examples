<?xml version="1.0" encoding="UTF-8"?>
<!--
  The same shape as maven-service's build, and deliberately so: what this
  example is about is not the build.

  One thing does differ. `target/classes` is where the editor's language server
  compiles to and where the debugger's hot code replace reads from, so the
  output directory being the ordinary Maven one is the whole reason a swap works
  here without any configuration at all.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.example</groupId>
	<artifactId>hot-swap</artifactId>
	<version>1.0.0</version>
	<packaging>jar</packaging>
	<name>hot-swap</name>

	<properties>
		<maven.compiler.release>21</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<mainClass>com.example.hotswap.Ticker</mainClass>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.1</version>
				<configuration>
					<archive>
						<manifest>
							<mainClass>com.example.hotswap.Ticker</mainClass>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.3.0</version>
				<configuration>
					<mainClass>com.example.hotswap.Ticker</mainClass>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
