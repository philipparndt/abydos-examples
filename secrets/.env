# Committed on purpose, which is what makes this the *Committed to git* case:
# the values are in the history already, and adding a line to `.gitignore` now
# would not take them out of it. Every one of them is invented.
API_KEY=not-a-real-key-0000
DATABASE_PASSWORD=hunter2

# A comment is not a secret, and neither is a blank line.
export TOKEN="not-a-real-token-0000"
EMPTY=
